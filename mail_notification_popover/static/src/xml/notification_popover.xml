<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.NotificationPopover" owl="1" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_NotificationPopover')]/t[@t-foreach='notifications']/div[hasclass('o_NotificationPopover_notification')]/t[@t-if='notification.partner']/span[last()]" position="after">
            (<span class="o_NotificationPopover_notificationPartnerEmail" t-esc="notification.partner.email"/>)
        </xpath>
    </t>
</templates>