<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.NotificationPopover" owl="1" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_NotificationPopover')]/t[@t-foreach='notifications']/div[hasclass('o_NotificationPopover_notification')]" position="after">
            <div class="o_NotificationPopover_notification">
                <i class="o_NotificationPopover_notificationIcon" t-att-class="iconClass" t-att-title="iconTitle" role="img"/>
                <t t-if="notification.partner.email">
                    <span class="o_NotificationPopover_notificationPartnerEmail" t-esc="notification.partner.email"/>
                </t>
            </div>
        </xpath>
    </t>
</templates>