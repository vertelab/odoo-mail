<odoo>
    <record id="view_mail_channel_form_inherit_auto_subscribe" model="ir.ui.view">
        <field name="name">discuss.channel.form.auto.subscribe.company</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="mail.discuss_channel_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='group_ids']" position="after">
                <field name="auto_subscribe_company_id" xwidget="many2many_tags" invisible="channel_type != 'channel'" string="Auto Subscribe Company" />
            </xpath>
        </field>
    </record>
</odoo>
